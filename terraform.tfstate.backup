            "output_sha": "feb9faca2458af0cc39876202cb108a5ff21cd96",
            "output_sha256": "524e7d8b18c46830090e528b804ff6451b020d2b5eacf9a16dfa08d69b1173dd",
            "output_sha512": "544f1014252a7e353fecf89f6c789c82a7aaee4e94c66385f21a5160b2fb1f343ff9e624eb420d04ab26a704ffdfd195149404535d8243d199f81cc0c645a697",
            "output_size": 459,
            "source": [
              {
                "content": "import json\nimport boto3\n\ndef handler(event, context):\n    print(f\"Received event: {json.dumps(event)}\")\n          \n    s3_client = boto3.client('s3')\n          \n    for record in event.get('Records', []):\n        body = json.loads(record['body'])\n        message = json.loads(body.get('Message', '{}'))\n              \n        for s3_record in message.get('Records', []):\n            bucket = s3_record['s3']['bucket']['name']\n            key = s3_record['s3']['object']['key']\n            print(f\"Processing: s3://{bucket}/{key}\")\n          \n    return {\n        'statusCode': 200,\n        'body': json.dumps('Processing complete')\n    }\n",
                "filename": "lambda_function.py"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
